{
    "name": "eddiebyte/gcp-php-app",
    "description": "Minimal PHP-FPM status app that exercises Cloud Run, Cloud SQL, Secret Manager and a static bucket.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "App\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    },
    "config": {
        "platform": { "php": "8.3" },
        "sort-packages": true
    }
}
