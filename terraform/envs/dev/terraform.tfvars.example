# Copy to terraform.tfvars (git-ignored) and adjust per environment.
project_id             = "php-cloudrun-platform"
region                 = "europe-west1"
environment            = "dev"
app_name               = "php-app"
artifact_repository_id = "php-app"

# Cloud SQL
db_tier                = "db-f1-micro"
db_availability_type   = "ZONAL"
db_name                = "app"
db_user                = "app"
db_deletion_protection = false

# Cloud Run / load balancer
min_instances = 0
max_instances = 3
enable_https           = false # true = managed cert on <ip>.nip.io (+1 forwarding rule)
redirect_http_to_https = false # flip to true only once the cert is ACTIVE
