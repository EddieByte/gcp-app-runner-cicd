# Copy to terraform.tfvars (git-ignored) and adjust.
project_id = "php-cloudrun-platform"
region     = "europe-west1"

# Set true to keep previous state versions (recommended for shared or production use).
enable_state_versioning = false

# CI/CD (Workload Identity Federation)
github_repository = "EddieByte/gcp-app-runner-cicd"
